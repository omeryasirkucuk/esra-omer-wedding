# Port the Express API listens on (and serves the built site from in production).
API_PORT=8787

# Where the local storage adapter writes guest data (RSVP, posts, uploads).
# Defaults to ./data next to the server.
STORAGE_DIR=./data

# Storage backend: "local" today, "s3" once a bucket is wired up.
STORAGE_DRIVER=local

# Front-end: base URL of the API. Empty means same-origin (local full-stack).
# When the front-end is hosted statically (e.g. GitHub Pages) point this at the
# deployed API host, e.g. https://api.esra-omer.example
VITE_API_BASE=
