# Copy to .env and adjust. Only real secrets live here — everything else
# (couple, date, venue, music file, OG image, site URL) is edited in the admin.

# Port the Express API listens on (and serves the built site from in
# production). Hosting platforms usually inject PORT instead.
API_PORT=8787

# Storage backend: "local" writes to STORAGE_DIR, "s3" uses the bucket below.
STORAGE_DRIVER=local

# Where the local storage adapter writes guest data (RSVP, posts, uploads).
STORAGE_DIR=./data

# --- S3 (set STORAGE_DRIVER=s3 to enable) ----------------------------------
# Private bucket; media is served through the API, so it never needs to be
# public. The IAM user needs Get/Put/DeleteObject + ListBucket on this bucket.
#S3_BUCKET=your-wedding-bucket
#S3_REGION=eu-central-1
#AWS_ACCESS_KEY_ID=...
#AWS_SECRET_ACCESS_KEY=...

# Storage key of the invitation music. The admin System tab uploads to this
# key; only override it if you placed the file somewhere else yourself.
#MUSIC_KEY=music/davetiye-music.mp3

# --- Admin dashboard ---------------------------------------------------------
# Initial accounts as "user:pass,user:pass" (default: esra:omer,omer:esra).
# Accounts managed later from the admin System tab override these.
#ADMIN_USERS=omer:esra
# HMAC key signing admin session tokens. Set any long random string.
#ADMIN_SECRET=change-me-to-a-long-random-string

# Front-end: base URL of the API. Empty means same-origin (local full-stack).
# Only needed when the front-end is hosted statically on another origin.
VITE_API_BASE=
