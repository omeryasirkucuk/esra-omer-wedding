{
  "name": "esra-omer-wedding",
  "version": "1.0.0",
  "private": true,
  "description": "Wedding microsite for Esra & Omer: invitation, games, photo/video album and a live memory board.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c magenta,cyan \"vite\" \"node server/index.js\"",
    "build": "vite build",
    "start": "npm run build && cross-env NODE_ENV=production node server/index.js",
    "server": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/lib-storage": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "@vitejs/plugin-react": "^4.3.1",
    "archiver": "^8.0.0",
    "autoprefixer": "^10.4.19",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "framer-motion": "^11.3.8",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.0.7",
    "postcss": "^8.4.40",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.25.1",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.7",
    "vite": "^5.3.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
